# Core settings

# IP address the proxy listens on. Must be 0.0.0.0 for Docker Compose.
PROXY_LISTEN_IP=0.0.0.0

# Port the proxy listens on.
PROXY_LISTEN_PORT=8787

# IP address or hostname used for UDP connections.
# Leave empty if not required.
UDP_RELAY_HOST=

# Paths to the certificate and private key inside the Docker container.
# Leave empty to use the default self-signed certificate/key.
TLS_CERT_FILE=
TLS_KEY_FILE=

# Host directory mounted into the Docker container.
# Do not use test certificates in production.
CERTS_DIR=./proxy/test-certs

# Token for worker authentication.
WORKER_TOKEN=change-me-worker-token

# Hostname or IP address used to connect to the broker.
BROKER_CONNECT_HOST=broker

# Port used by the broker for listening and by clients for connections.
BROKER_PORT=8899

# Token for proxy authentication.
PROXY_TOKEN=change-me-proxy-token

# Secret used to obscure the WebSocket endpoint path.
RANDOM_ENDPOINT_SECRET=change-me-endpoint-secret

# Log level: debug, info, warn, error.
LOG_LEVEL=debug

DEFAULT_GROUP_NAME=direct
DOMAINS_REDIS_KEY=routes:domains
CIDRS_REDIS_KEY=routes:cidr
DEFAULT_ROUTE_REDIS_KEY=routes:default


# Admin (Django-based)

# Set to False in production.
DEBUG=True

# Generate a unique value for production.
DJANGO_SECRET_KEY=change-me-django-secret-key

# Comma-separated list of allowed hosts.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Set to False in production.
DJANGO_SHOW_SWAGGER=True

DJANGO_STATIC_ROOT=/data/static/

# Comma-separated list of trusted origins.
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost


# PostgreSQL

POSTGRES_HOST=proxy_postgres
POSTGRES_PORT=5432
POSTGRES_DB=proxy
POSTGRES_USER=proxy
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_VOLUME=proxy_postgres_data


# Redis

REDIS_HOST=proxy_redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=change-me-redis-password
REDIS_VOLUME=proxy_redis_data


# Admin Frontend

FRONT_PORT=5555
